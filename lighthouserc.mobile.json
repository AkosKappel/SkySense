{
	"ci": {
		"collect": {
			"startServerCommand": "SKYSENSE_FIXTURES=1 pnpm preview --port 4173 --strictPort",
			"startServerReadyPattern": "Local",
			"url": [
				"http://localhost:4173/?choose",
				"http://localhost:4173/p/48.15,17.11/Bratislava",
				"http://localhost:4173/settings",
				"http://localhost:4173/about",
				"http://localhost:4173/privacy",
				"http://localhost:4173/compare?a=48.15,17.11&an=Bratislava&b=40.42,-3.7&bn=Madrid"
			],
			"numberOfRuns": 3,
			"settings": {
				"chromeFlags": "--no-sandbox --headless=new",
				"skipAudits": ["is-crawlable"]
			}
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": ".*",
					"aggregationMethod": "median-run",
					"assertions": {
						"categories:performance": [
							"warn",
							{
								"minScore": 0.9
							}
						]
					}
				}
			]
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "lighthouse-report-mobile"
		}
	}
}
